{
  "name": "aegis",
  "version": "1.0.0",
  "description": "Privacy-focused browser with per-user workspaces",
  "main": "main.js",
  "build": {
    "appId": "com.aegis.browser",
    "productName": "AEGIS",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "login.html",
      "workspace.html",
      "controls.html",
      "dashboard.html",
      "settings.html",
      "parameters.html",
      "confirm-quit.html",
      "logo.png",
      "logo.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logo.ico"
    },
    "portable": {
      "artifactName": "AEGIS-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "AEGIS-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AEGIS",
      "installerIcon": "installer.ico",
      "uninstallerIcon": "installer.ico",
      "installerHeaderIcon": "installer.ico",
      "uninstallDisplayName": "AEGIS Browser",
      "deleteAppDataOnUninstall": false,
      "license": false
    }
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . AEGIS --platform=win32 --arch=x64 --icon=logo.ico --out=dist --overwrite",
    "portable": "node create-logo.js && electron-builder --win portable",
    "installer": "node create-logo.js && electron-builder --win nsis",
    "release": "node create-logo.js && electron-builder --win nsis portable",
    "create-logo": "node create-logo.js",
    "prebuild": "node create-logo.js",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.1"
  }
}
